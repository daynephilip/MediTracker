# Groq Cloud API (free tier - get key from console.groq.com)
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=qwen-3.5-9b

# OCR.space API (free tier - get key from ocr.space/ocrapi)
OCR_SPACE_API_KEY=your_key_here

# Firebase Admin SDK credentials path (if using service account JSON)
# FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json
